<style>
:root{--bg:#090d18;--panel:#101827;--panel2:#141f31;--text:#edf3ff;--muted:#9eacc3;--line:#26354b;--accent:#78e0c3;--accent2:#8da9ff;--on-accent:#071510;--shadow:0 18px 55px #0005;--max:1160px;--radius:17px;--card-bg:linear-gradient(150deg,#121d2d,#0d1421);--hero-card-bg:linear-gradient(145deg,#17243a,#0d1422);--input-bg:#0b1320;--topbar-bg:#090d18d9;--glow:#1c3150}
[data-theme="light"]{--bg:#f4f7fb;--panel:#fff;--panel2:#edf2f8;--text:#152235;--muted:#5d6c80;--line:#d9e1eb;--accent:#0f7a5c;--accent2:#4768c9;--on-accent:#fff;--shadow:0 18px 55px #24364b18;--card-bg:linear-gradient(145deg,#fff,#f2f6fb);--hero-card-bg:linear-gradient(145deg,#fff,#f2f6fb);--input-bg:#fff;--topbar-bg:#f4f7fbe8;--glow:#dce8f6}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:90px}body{margin:0;background:radial-gradient(ellipse at 80% 0%,var(--glow) 0,transparent 34%),var(--bg);color:var(--text);font:15px/1.65 Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;-webkit-font-smoothing:antialiased}a{color:inherit;text-decoration:none}button{font:inherit}:focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:6px}.wrap{width:min(var(--max),calc(100% - 40px));margin:auto}.skip-link{position:absolute;left:-9999px;top:0;background:var(--accent);color:var(--on-accent);padding:10px 16px;font-weight:800;z-index:100;border-radius:0 0 10px 0}.skip-link:focus{left:0}
.topbar{position:sticky;top:0;z-index:20;background:var(--topbar-bg);backdrop-filter:blur(18px);border-bottom:1px solid var(--line)}.nav{min-height:72px;display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{font-weight:800;letter-spacing:-.04em;font-size:20px}.brand span{color:var(--accent)}.links{display:flex;gap:23px;align-items:center}.links a{font-size:13px;color:var(--muted)}.links a:hover,.links a.active{color:var(--accent)}.actions{display:flex;gap:9px}.iconbtn,.menuBtn{border:1px solid var(--line);background:var(--panel);color:var(--text);border-radius:11px;padding:9px 12px;cursor:pointer;min-width:42px;min-height:42px}.menuBtn{display:none}
.hero{padding:94px 0 78px;display:grid;grid-template-columns:1.2fr .8fr;gap:55px;align-items:center}.eyebrow{color:var(--accent);text-transform:uppercase;letter-spacing:.16em;font-size:11px;font-weight:800}.hero h1{font-size:clamp(42px,6vw,72px);line-height:1.04;letter-spacing:-.065em;margin:18px 0}.gradient{background:linear-gradient(100deg,var(--text) 10%,#8ee8cd 60%,#9aaeff);-webkit-background-clip:text;background-clip:text;color:transparent}[data-theme="light"] .gradient{background:linear-gradient(100deg,#152235 10%,#16866b 60%,#4768c9);-webkit-background-clip:text;background-clip:text}.lead{font-size:18px;color:var(--muted);max-width:650px}.cta{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.btn{display:inline-flex;align-items:center;gap:9px;border-radius:12px;padding:12px 17px;font-weight:750;font-size:13px;border:1px solid var(--line);background:var(--panel);color:var(--text);cursor:pointer;transition:transform .15s ease}.btn.primary{background:var(--accent);color:var(--on-accent);border-color:var(--accent)}.btn:hover{transform:translateY(-2px)}.hero-card{border:1px solid var(--line);background:var(--hero-card-bg);border-radius:24px;padding:25px;box-shadow:var(--shadow);position:relative;overflow:hidden}.hero-card:before{content:"";position:absolute;width:220px;height:220px;border-radius:50%;background:#78e0c31a;filter:blur(5px);right:-70px;top:-85px;pointer-events:none}.avatar{width:68px;height:68px;border-radius:20px;background:linear-gradient(135deg,#78e0c3,#8da9ff);color:#071510;display:grid;place-items:center;font-size:27px;font-weight:900}.hero-card h3{font-size:22px;margin:17px 0 4px}.hero-card p{color:var(--muted);margin:0}.statgrid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:23px}.stat{padding:13px;border-radius:13px;background:var(--panel2);border:1px solid var(--line)}.stat b{display:block;font-size:20px;color:var(--accent)}.stat small{color:var(--muted)}
.section{padding:76px 0;border-top:1px solid var(--line)}.section-head{display:flex;justify-content:space-between;gap:30px;align-items:end;margin-bottom:30px}.kicker{font-size:11px;color:var(--accent);font-weight:800;letter-spacing:.16em;text-transform:uppercase}.section h2{font-size:clamp(30px,4vw,43px);letter-spacing:-.045em;line-height:1.12;margin:8px 0}.section-intro{color:var(--muted);max-width:560px;margin:0}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.card{border:1px solid var(--line);background:var(--card-bg);border-radius:var(--radius);padding:21px;transition:transform .2s ease,border-color .2s ease}.card:hover{transform:translateY(-4px);border-color:var(--accent2);box-shadow:var(--shadow)}.card .num{font-size:11px;color:var(--accent);letter-spacing:.1em;font-weight:800}.card h3{margin:8px 0;font-size:18px;letter-spacing:-.02em}.card p{color:var(--muted);font-size:13px;margin:0}.tags{display:flex;flex-wrap:wrap;gap:7px;margin-top:15px}.tag{font-size:11px;color:var(--text);background:var(--panel2);border:1px solid var(--line);padding:5px 8px;border-radius:7px}.about{display:grid;grid-template-columns:1fr 1fr;gap:22px}.panel{border:1px solid var(--line);background:var(--panel);border-radius:18px;padding:24px}.panel p{color:var(--muted)}.bullets{padding-left:19px;color:var(--muted)}.bullets li{margin:8px 0}
.legend{display:flex;gap:18px;flex-wrap:wrap;font-size:12px;color:var(--muted);margin-bottom:14px}.legend span{display:inline-flex;align-items:center;gap:7px}.dot{width:9px;height:9px;border-radius:50%;display:inline-block}.dot.hands-on{background:var(--accent)}.dot.working{background:var(--accent2)}.dot.learning{background:#f4d28a}.skillgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.skill{padding:17px;border-radius:14px;background:var(--panel);border:1px solid var(--line)}.skill strong{display:flex;align-items:center;gap:8px;margin-bottom:7px}.skill span{font-size:12px;color:var(--muted)}
.project-toolbar{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:8px}.filter{border:1px solid var(--line);background:var(--panel);color:var(--muted);border-radius:99px;padding:8px 13px;font-size:12px;cursor:pointer;min-height:36px}.filter[aria-pressed="true"]{background:var(--accent);color:var(--on-accent);border-color:var(--accent);font-weight:800}.result-count{font-size:12px;color:var(--muted);margin:0 0 16px}.project{display:flex;flex-direction:column;min-height:240px}.project[hidden]{display:none}.project .status{font-size:10px;text-transform:uppercase;letter-spacing:.1em;color:#f4d28a;font-weight:800}[data-theme="light"] .project .status{color:#8a6d1f}.project .details{margin-top:auto;padding-top:16px}.textlink{color:var(--accent);font-size:12px;font-weight:800;cursor:pointer;background:none;border:0;padding:4px 0}.textlink:hover{text-decoration:underline}
.timeline{border-left:1px solid var(--line);margin-left:8px;padding-left:25px}.event{position:relative;padding:0 0 25px}.event:before{content:"";position:absolute;left:-31px;top:7px;width:11px;height:11px;background:var(--accent);border-radius:50%;box-shadow:0 0 0 5px #78e0c31a}.event h3{margin:0 0 5px}.event p{margin:0;color:var(--muted);font-size:13px}
.contact{display:grid;grid-template-columns:1fr 1fr;gap:25px;align-items:start}.contactbox{padding:25px;border-radius:18px;border:1px solid var(--line);background:var(--panel)}.contactbox label{display:block;font-size:12px;color:var(--muted);margin:12px 0 5px}.contactbox input,.contactbox textarea{width:100%;padding:12px;border-radius:10px;border:1px solid var(--line);background:var(--input-bg);color:var(--text);font:inherit}.contactbox textarea{min-height:110px;resize:vertical}.form-msg{font-size:12px;margin-top:12px;min-height:1.4em}.form-msg.error{color:#ff9d9d}[data-theme="light"] .form-msg.error{color:#b3261e}.form-msg.ok{color:var(--accent)}.social-row{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.social-row a{font-size:12px;font-weight:800;border:1px solid var(--line);border-radius:99px;padding:8px 13px;background:var(--panel)}.social-row a:hover{border-color:var(--accent);color:var(--accent)}.muted{color:var(--muted)}.footer{padding:27px 0;color:var(--muted);font-size:12px;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}.footer a:hover{color:var(--accent)}
.modal{position:fixed;inset:0;background:#02050bd9;display:none;place-items:center;padding:20px;z-index:40}.modal.show{display:grid}.modalbox{max-width:560px;width:100%;max-height:85vh;overflow:auto;background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:25px;position:relative}.modalbox h2{margin:8px 0}.close{position:absolute;right:16px;top:14px}
@media(max-width:850px){.links{display:none;position:absolute;top:72px;left:0;right:0;background:var(--bg);padding:18px 22px;border-bottom:1px solid var(--line);flex-direction:column;align-items:flex-start}.links.open{display:flex}.menuBtn{display:block}.hero{grid-template-columns:1fr;padding-top:65px;gap:30px}.grid{grid-template-columns:repeat(2,1fr)}.skillgrid{grid-template-columns:repeat(2,1fr)}.about,.contact{grid-template-columns:1fr}.section-head{display:block}.section-intro{margin-top:12px}}
@media(max-width:560px){.wrap{width:min(100% - 28px,var(--max))}.hero{padding:55px 0}.grid{grid-template-columns:1fr}.section{padding:58px 0}.hero h1{font-size:45px}.footer{flex-direction:column}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.btn:hover,.card:hover{transform:none}*{transition:none!important}}
@media print{.topbar,.cta,.project-toolbar,.contactbox,.modal,.skip-link{display:none!important}body{background:#fff;color:#000}.section{padding:24px 0}}
